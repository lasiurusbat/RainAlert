# Keep the build context small. Everything here is either irrelevant to the
# image or a local artefact that would only bloat the build.

.git
.gitignore
.github

# The test suites are copied into the image so that
# "docker compose run --rm tests" can run them against the deployed image,
# so they are deliberately NOT ignored here - except the browser suite,
# which needs a Chrome the image does not have.
tests/test_browser.py

# Local configuration and secrets
.env
.env.*
!.env.example

# Virtual environments
.venv
venv
env

# Python bytecode and caches
**/__pycache__
**/*.py[cod]
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Documentation and project notes
docs
README.md
CLAUDE.md
DEPLOY.md
tech-stack.md
implementation-plan.md
refactor-plan.md
RainAlert-Ideas-for-Alerting-Users.md
render.yaml

# Design mockups. They are not part of the app; they are pictures of what
# it might look like.
design

# Local artefacts that are not in the repository but sit in the working
# directory: the before/after snapshots of tools/snapshot.py, and the
# screenshots the tools in tools/ write.
snapshots
shot-*.png
crop-*.png

# The skills and settings of the editor that happens to be driving this.
.claude

# Development tools. The icon generator needs a browser, and the icons it
# writes are committed, so nothing in the image needs it.
tools

# Editor and OS noise
.idea
.vscode
.DS_Store
Thumbs.db
*.swp

# The compose file and this file are not needed inside the image
docker-compose.yml
.dockerignore
