# Local settings for `docker compose`.
#
# Copy this file to `.env` next to docker-compose.yml and edit it there.
# `.env` is git-ignored and never goes into the image.
#
# Compose fills these into the container, and the app reads them as ordinary
# environment variables - see rainalert/config.py for the list of every
# setting and what it does. A name that is left out here is simply not
# passed, and the app uses its own default.

# The site's own address, used for the canonical links, the social card, the
# sitemap and the structured data. It defaults to the real address, so a
# container and a local run agree; set it here to serve the container from
# somewhere else.
#
# The test container deliberately does NOT get this one: the offline suite
# asserts the default address, so it has to run against the default.
SITE_URL=https://rainalert.live

# Optional donation link. Only an absolute https:// URL is accepted, and an
# empty value hides the link everywhere. Voluntary one-off donations only -
# Open-Meteo's free terms are non-commercial, so the page behind this link
# must not sell memberships, extras or subscriptions.
DONATION_URL=

# The chance at which carrying an umbrella starts to be worth it, and the
# two band edges below it. These are the app's own defaults.
UMBRELLA_THRESHOLD=50
SEVERITY_LOW_MAX=30
SEVERITY_MODERATE_MAX=60

# The scale the temperatures come in: celsius or fahrenheit.
TEMPERATURE_UNIT=celsius
